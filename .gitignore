data/
__pycache__/
*.pyc
logs/

# Downloaded papers: not our output, and a PDF is a permanent binary blob in git history.
# The IEEE Xplore full text also carries "Authorized licensed use limited to ... Restrictions
# apply" in its own footer. Read it from docs/ locally; refs/ carries the text extraction we
# actually cite line numbers against.
docs/*.pdf

# local-only: upstream clones/weights (39 GB), docx build intermediates, soffice proof renders
refs/jrm-adm/
docs/arxiv/_docx.tex
docs/arxiv/proof/
